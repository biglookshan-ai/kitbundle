{%- comment -%}
  KitBundle cart guard (app embed): keeps included parts and free gifts in step
  with their main products in the cart. The stamps of the cart's products (and
  this page's product) are handed over so it rarely needs to look anything up.
{%- endcomment -%}
<script type="application/json" data-kb-stamps>{
  {%- for item in cart.items -%}
    {%- if item.product -%}
      {%- assign gt = item.product.metafields.custom.gift_trigger -%}
      {{ item.product.handle | json }}:{% if gt != blank %}{{ gt.value | json }}{% else %}[]{% endif %},
    {%- endif -%}
  {%- endfor -%}
  {%- if product -%}
    {%- assign gt = product.metafields.custom.gift_trigger -%}
    {{ product.handle | json }}:{% if gt != blank %}{{ gt.value | json }}{% else %}[]{% endif %},
  {%- endif -%}
  "":[]}</script>
<script src="{{ 'cart-guard.js' | asset_url }}" defer></script>
{% schema %}{"name": "KitBundle cart guard","target": "body","settings": []}{% endschema %}
