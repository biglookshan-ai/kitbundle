// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
// Production DB is Railway Postgres. For local `shopify app dev`, put the
// Railway DATABASE_URL in .env (or a local postgres) — see .env.example.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Dashboard index — a mirror of each main product's `custom.addon_config`
// metafield so the admin home can list configured products without scanning
// the whole catalog. The metafield on the product stays the source of truth.
model BundleConfig {
  id             String   @id @default(cuid())
  shop           String
  productId      String   // gid://shopify/Product/...
  productTitle   String
  productHandle  String
  productImage   String?  // featured image URL, for the dashboard lists
  groupCount     Int      @default(0)
  accessoryCount Int      @default(0)
  // Denormalised lightweight summary of each group (code/type/title/limited/…)
  // so the "by bundle" / "by add-on" dashboard views don't refetch every
  // product's metafield. The metafield stays the source of truth.
  groupsJson     String   @default("[]")
  updatedAt      DateTime @updatedAt

  @@unique([shop, productId])
  @@index([shop])
}

// A cross-product "gift with purchase" campaign. Source of truth for the admin;
// each campaign also writes its own automatic discount node (time-gated by
// Shopify) whose `$app:gift` metafield carries the rules the Function reads, and
// stamps `custom.gift_trigger` on its trigger products.
model GiftCampaign {
  id            String    @id // camp_xxxx — also the node metafield id + line tag
  shop          String
  title         String    @default("")
  enabled       Boolean   @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  perQualifying Int       @default(1) // free gifts per qualifying unit (buy 2 -> 2)
  rewardMode    String    @default("fixed") // "fixed" (auto-add) | "choice" (picker)
  chooseCount   Int       @default(1) // choice mode: how many different gifts
  // 1 = legacy rows (All mode ignored perQualifying); 2 = perQualifying is the
  // per-gift quantity in every mode. Saving from the current editor writes 2.
  rulesVersion  Int       @default(1)
  badgeText     String    @default("")
  subtitle      String    @default("") // storefront prompt above the gift picker
  hideWhenSoldOut Boolean @default(false) // hide sold-out gifts / the group
  // JSON arrays of refs { id, title, handle, image }.
  triggerProductsJson    String @default("[]")
  triggerCollectionsJson String @default("[]")
  giftProductsJson       String @default("[]")
  // Rule-based triggers (step 2): JSON string arrays, matched case-insensitively.
  triggerTagsJson        String  @default("[]")
  triggerVendorsJson     String  @default("[]")
  triggerTypesJson       String  @default("[]")
  allProducts            Boolean @default(false) // every product in the store
  // Carve-outs from the rule-based triggers (not from directly listed products).
  excludeTagsJson        String  @default("[]")
  excludeProductsJson    String  @default("[]") // refs like triggerProductsJson
  nodeId        String? // gid://shopify/DiscountAutomaticNode/<n>
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([shop])
}

// Gifts module — coverage index: which product plays which role in which
// campaign (trigger = "buy this", gift = "get this"), with the product facts the
// management views filter on. Derived data: rebuilt from GiftCampaign + Shopify
// on campaign save/delete and on demand; campaigns stay the source of truth.
model GiftCoverage {
  id             String   @id @default(cuid())
  shop           String
  campaignId     String
  productId      String   // gid://shopify/Product/...
  role           String   // "trigger" | "gift"
  // How a trigger product got in: JSON array of labels, e.g.
  // ["Direct","Collection: Lenses"]. Empty for gifts.
  viaJson        String   @default("[]")
  title          String   @default("")
  handle         String   @default("")
  image          String?
  vendor         String   @default("")
  productType    String   @default("")
  status         String   @default("") // ACTIVE | DRAFT | ARCHIVED
  totalInventory Int?
  updatedAt      DateTime @updatedAt

  @@unique([shop, campaignId, productId, role])
  @@index([shop, role])
  @@index([shop, productId])
}

// Gifts module — one row per sync run (full re-sync, or a product/collection
// webhook), so the admin can show when stamps were last reconciled.
model GiftSyncLog {
  id        String   @id @default(cuid())
  shop      String
  kind      String   // "full" | "product" | "collection"
  scanned   Int      @default(0) // products compared
  changed   Int      @default(0) // stamps actually written
  errors    String   @default("")
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
}

// Gifts module — hash of the gift_trigger stamp last written to each product,
// so a full sync writes only products whose stamp actually changes without
// re-reading every product's metafield. Webhook syncs read the live value and
// refresh this, so drift self-corrects.
model GiftStamp {
  shop      String
  productId String   // gid://shopify/Product/...
  hash      String
  updatedAt DateTime @updatedAt

  @@id([shop, productId])
}

// Per-shop app settings (opt-in behaviors). One row per shop.
model ShopSettings {
  shop      String  @id
  // When true, KitBundle tags products that have a live offer with `offerTag`,
  // so a merchant's search/collections (or a custom search engine) can find
  // them. Off by default — a public app must not touch product tags uninvited.
  tagOffers Boolean @default(false)
  offerTag  String  @default("kitbundle")
  updatedAt DateTime @updatedAt @default(now())
}
